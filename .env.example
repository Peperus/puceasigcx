# Django
APP_NAME=puceasig
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-secret-key-change-me-2026-07-puceasigcx
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000

# Database
DATABASE_URL=postgres://puceasig:puceasig_dev_password@db:5432/puceasig
POSTGRES_DB=puceasig
POSTGRES_USER=puceasig
POSTGRES_PASSWORD=puceasig_dev_password

# Redis
REDIS_URL=redis://redis:6379/0

# API / CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DRF_ANON_THROTTLE_RATE=100/minute
DRF_USER_THROTTLE_RATE=1000/minute
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# S3-compatible storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
S3_BUCKET_NAME=puceasig-local
S3_REGION_NAME=us-east-1
SYLLABUS_SIGNED_FILE_MAX_BYTES=5242880

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.edu

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
